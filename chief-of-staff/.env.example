# ---- Claude ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Microsoft 365 (Outlook, Calendar, Teams) ----
# Create an app registration in Entra ID -> "Mobile and desktop applications",
# enable "Allow public client flows". Delegated scopes only, read-only in V1.
MS_TENANT_ID=common
MS_CLIENT_ID=
# Space-separated. Keep this list minimal - every scope is a privacy decision.
MS_SCOPES=User.Read Calendars.Read Mail.Read Chat.Read

# ---- Atlassian (Jira + Confluence) ----
# Self-service token: id.atlassian.com -> Security -> API tokens. No admin needed.
ATLASSIAN_SITE=https://<your-site>.atlassian.net
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=

# ---- Behaviour ----
COS_NAME=Sundari
COS_MODEL=claude-opus-5
COS_EFFORT=high

# ---- Claude ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- Microsoft 365 (Outlook, Calendar, Teams) ----
# Create an app registration in Entra ID -> "Mobile and desktop applications",
# enable "Allow public client flows". Delegated scopes only, read-only in V1.
MS_TENANT_ID=common
MS_CLIENT_ID=
# Space-separated. Keep this list minimal - every scope is a privacy decision.
MS_SCOPES=User.Read Calendars.Read Mail.Read Chat.Read

# ---- Atlassian (Jira + Confluence) ----
# Self-service token: id.atlassian.com -> Security -> API tokens. No admin needed.
ATLASSIAN_SITE=https://<your-site>.atlassian.net
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=

# ---- GitHub (office) ----
# Prefixed COS_ deliberately: a bare GITHUB_TOKEN is injected by GitHub Actions
# and other tooling, and we must never silently authenticate as something else.
# Self-service token, no admin needed. Prefer a FINE-GRAINED token with read-only
# permissions: Contents: Read, Pull requests: Read, Metadata: Read.
# github.com  -> leave GITHUB_API unset, set GITHUB_ORG to your company org
# Enterprise  -> COS_GITHUB_API=https://github.<company>.internal/api/v3
COS_GITHUB_API=https://api.github.com
COS_GITHUB_TOKEN=
# Scopes every search to this org. Strongly recommended - without it, searches
# reach across every repo the token can see, including your personal ones.
COS_GITHUB_ORG=

# ---- Behaviour ----
COS_NAME=Sundari
COS_MODEL=claude-opus-5
COS_EFFORT=high
